.env
.DS_Store
__pycache__/
*.pyc

# Raw fetch outputs (regenerate with fetch_interim_mcp.py / update_dataset.py)
data/raw/*.csv

# Large data artifacts — regenerate locally
*.parquet
data/predictions/
models/

# Üretim modeli ve live forecast — git'te tutulur (Streamlit Cloud için)
!models/rolling_ptf_next24/
!models/rolling_ptf_next24/**
!data/live/
!data/live/**

# Large sequence tensors — regenerate with: python run_sequence.py
data/model/*.npy
data/model_residual/*.npy
data/model_residual/*.pkl

# Optional large figures
reports/figures/*.png

# Timestamped report snapshots (keep only *_latest.* in git)
reports/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.json
reports/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.md

# Cache / temp
.cache/
*.tmp
*.temp
data/model_residual/anchor_train.csv
data/model_residual/anchor_val.csv
